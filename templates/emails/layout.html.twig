{# Mise en page commune des e-mails : tableaux + styles en ligne (seul rendu fiable dans les messageries). #}
<!DOCTYPE html>
<html lang="{{ lang }}">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ email.subject }}</title>
  </head>
  <body style="margin:0;padding:0;background:#f4f1ec;font-family:Arial,Helvetica,sans-serif;color:#2b2b2b;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f1ec;">
      <tr>
        <td align="center" style="padding:24px 12px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;background:#ffffff;border-radius:8px;">
            <tr>
              <td style="padding:24px 32px;border-bottom:1px solid #e8e2d9;font-size:22px;font-weight:bold;color:#7a3e2e;">
                Plaisir d'Oc
              </td>
            </tr>
            <tr>
              <td style="padding:24px 32px;font-size:15px;line-height:1.6;">
                <p style="margin:0 0 16px;">{{ 'common.greeting'|trans(params, 'emails') }}</p>

                {% block content %}{% endblock %}

                {% if link %}
                  <p style="margin:24px 0;">
                    <a href="{{ link }}" style="display:inline-block;padding:12px 24px;background:#7a3e2e;color:#ffffff;text-decoration:none;border-radius:6px;font-weight:bold;">
                      {{ (key ~ '.cta')|trans(params, 'emails') }}
                    </a>
                  </p>
                {% endif %}

                <p style="margin:24px 0 0;">{{ 'common.signature'|trans(params, 'emails')|nl2br }}</p>
              </td>
            </tr>
            <tr>
              <td style="padding:16px 32px;border-top:1px solid #e8e2d9;font-size:12px;color:#8a8279;">
                {{ 'common.footer'|trans(params, 'emails') }}
                <a href="{{ frontUrl }}" style="color:#8a8279;">{{ frontUrl }}</a>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
